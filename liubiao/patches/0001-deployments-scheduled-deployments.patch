+	assert.NoError(t, err)
+	assert.Equal(t, model.StatusQueryScheduled, query.Status)
+}
+
+// liubiao：创建计划部署时校验单阶段与开始时间上限（默认 72 小时，可配置）。
+func TestPostScheduledDeployment(t *testing.T) {
+	t.Parallel()
+	phase := func(start time.Time, extra map[string]interface{}) []map[string]interface{} {
+		p := map[string]interface{}{"batch_size": 100, "start_ts": start.Format(time.RFC3339), "delay": 0}
+		for k, v := range extra {
+			p[k] = v
+		}
+		return []map[string]interface{}{p}
+	}
+	body := func(phases interface{}) map[string]interface{} {
+		return map[string]interface{}{
+			"name":          "dev",
+			"artifact_name": "app-1.0",
+			"devices":       []string{"f826484e-1157-4109-af21-304e6d711560"},
+			"phases":        phases,
+		}
+	}
+	now := time.Now()
+
+	testCases := []struct {
+		Name      string
+		Body      interface{}
+		MaxAhead  time.Duration
+		Code      int
+		ErrSubstr string
+	}{{
+		Name: "ok, within default 72h",
+		Body: body(phase(now.Add(48*time.Hour), nil)),
+		Code: http.StatusCreated,
+	}, {
+		Name:      "error, beyond default 72h",
+		Body:      body(phase(now.Add(80*time.Hour), nil)),
+		Code:      http.StatusBadRequest,
+		ErrSubstr: "计划开始时间最多只能在 72 小时之后",
+	}, {
+		Name:     "ok, configured limit",
+		Body:     body(phase(now.Add(80*time.Hour), nil)),
+		MaxAhead: 96 * time.Hour,
+		Code:     http.StatusCreated,
+	}, {
+		Name:      "error, configured limit",
+		Body:      body(phase(now.Add(30*time.Hour), nil)),
+		MaxAhead:  24 * time.Hour,
+		Code:      http.StatusBadRequest,
+		ErrSubstr: "计划开始时间最多只能在 24 小时之后",
+	}, {
+		Name:      "error, partial batch",
+		Body:      body(phase(now.Add(time.Hour), map[string]interface{}{"batch_size": 50})),
+		Code:      http.StatusBadRequest,
+		ErrSubstr: model.ErrScheduleBatchSize.Error(),
+	}, {
+		Name: "error, two phases",
+		Body: body(append(phase(now.Add(time.Hour), map[string]interface{}{"batch_size": 50}),
+			phase(now.Add(2*time.Hour), nil)...)),
+		Code:      http.StatusBadRequest,
+		ErrSubstr: model.ErrScheduleMultiplePhases.Error(),
+	}}
+	for _, tc := range testCases {
+		tc := tc
+		t.Run(tc.Name, func(t *testing.T) {
+			t.Parallel()
+			app := &mapp.App{}
+			app.On("CreateDeployment",
+				mock.MatchedBy(func(ctx context.Context) bool { return true }),
+				mock.MatchedBy(func(c *model.DeploymentConstructor) bool {
+					return c.StartTime() != nil && len(c.Phases) == 1
+				}),
+			).Return("foo", nil)
+			d := NewDeploymentsApiHandlers(nil, new(view.RESTView), app,
+				NewConfig().SetScheduleMaxAhead(tc.MaxAhead))
+			router := setUpTestRouter()
+			router.POST(ApiUrlManagementDeployments, d.PostDeployment)
+			req := rtest.MakeTestRequest(&rtest.TestRequest{
+				Method: "POST",
+				Path:   "http://localhost" + ApiUrlManagementDeployments,
+				Body:   tc.Body,
+			})
+
+			recorded := restutil.RunRequest(t, router, req)
+			assert.Equal(t, tc.Code, recorded.Recorder.Code)
+			if tc.ErrSubstr != "" {
+				assert.Contains(t, recorded.Recorder.Body.String(), tc.ErrSubstr)
+				app.AssertNotCalled(t, "CreateDeployment", mock.Anything, mock.Anything)
+			} else {
+				app.AssertExpectations(t)
+			}
+		})
+	}
+}
