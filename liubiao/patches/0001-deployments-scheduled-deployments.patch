+func TestDeploymentNotStartedAndStatusJSON(t *testing.T) {
+	t.Parallel()
+	future := time.Now().Add(time.Hour)
+	past := time.Now().Add(-time.Hour)
+
+	testCases := map[string]struct {
+		start      *time.Time
+		status     DeploymentStatus
+		notStarted bool
+		jsonStatus DeploymentStatus
+	}{
+		"future start, pending": {
+			start: &future, status: DeploymentStatusPending,
+			notStarted: true, jsonStatus: DeploymentStatusScheduled,
+		},
+		"past start, pending": {
+			start: &past, status: DeploymentStatusPending,
+			jsonStatus: DeploymentStatusPending,
+		},
+		"no start, pending": {
+			status: DeploymentStatusPending, jsonStatus: DeploymentStatusPending,
+		},
+		"future start, finished (aborted)": {
+			start: &future, status: DeploymentStatusFinished,
+			jsonStatus: DeploymentStatusFinished,
+		},
+	}
+	for name, tc := range testCases {
+		tc := tc
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			var phases []DeploymentPhase
+			if tc.start != nil {
+				phases = schedulePhase(tc.start, nil)
+			}
+			d, err := NewDeploymentFromConstructor(&DeploymentConstructor{
+				Name: "foo", ArtifactName: "bar", Phases: phases,
+			})
+			assert.NoError(t, err)
+			d.Status = tc.status
+			assert.Equal(t, tc.notStarted, d.NotStartedAt(time.Now()))
+
+			raw, err := json.Marshal(d)
+			assert.NoError(t, err)
+			var out struct {
+				Status DeploymentStatus  `json:"status"`
+				Phases []DeploymentPhase `json:"phases"`
+			}
+			assert.NoError(t, json.Unmarshal(raw, &out))
+			assert.Equal(t, tc.jsonStatus, out.Status)
+			if tc.start != nil && assert.Len(t, out.Phases, 1) {
+				assert.WithinDuration(t, *tc.start, *out.Phases[0].StartTs, time.Second)
+			}
+		})
+	}
+
+	t.Run("nil constructor", func(t *testing.T) {
+		assert.False(t, (&Deployment{}).NotStartedAt(time.Now()))
+	})
+}
+
+// 前端（企业版向导）提交的阶段带 delay 字段，开源解码时应忽略。
+func TestDecodeFrontendSchedulePayload(t *testing.T) {
+	t.Parallel()
+	body := `{"name":"dev","artifact_name":"app-1.0","devices":["d1"],` +
+		`"phases":[{"batch_size":100,"start_ts":"2026-11-20T14:00:00.000Z","delay":0}]}`
+	var c DeploymentConstructor
+	assert.NoError(t, json.Unmarshal([]byte(body), &c))
+	if assert.NotNil(t, c.StartTime()) {
+		assert.Equal(t, time.Date(2026, 11, 20, 14, 0, 0, 0, time.UTC), c.StartTime().UTC())
+	}
+	assert.NoError(t, c.ValidateNew())
+}
