+//    limitations under the License.
+
+// liubiao：计划部署（单阶段定时开始），仿照 Mender 企业版的做法：
+// 部署在创建时就写入数据库，设备在开始时间之前取更新时不下发；
+// 到点后由设备下一次轮询取走。只支持一个阶段，不支持分批发布。
+
+package model
+
+import (
+	"time"
+
+	"github.com/pkg/errors"
+)
+
+// DeploymentStatusScheduled 只用于 API 输出和列表查询，不写入数据库；
+// 数据库中未开始的计划部署状态仍是 pending。
+const DeploymentStatusScheduled DeploymentStatus = "scheduled"
+
+// ScheduleBatchSizeAll 是单阶段计划部署唯一允许的批次比例。
+const ScheduleBatchSizeAll = 100
+
+// DeploymentPhase 与企业版 API 的阶段字段兼容（只取开源需要的部分）。
+// 前端会额外发送 delay 等字段，解码时忽略。
+type DeploymentPhase struct {
+	// BatchSize 本阶段覆盖的设备百分比；计划部署只允许不填或 100
+	BatchSize *int `json:"batch_size,omitempty" bson:"batch_size,omitempty"`
+	// StartTs 本阶段开始时间；不填表示立即开始
+	StartTs *time.Time `json:"start_ts,omitempty" bson:"start_ts,omitempty"`
+}
+
+var (
+	ErrScheduleMultiplePhases = errors.New(
+		"计划部署只支持一个阶段（定时开始），不支持分批发布")
+	ErrScheduleBatchSize = errors.New(
+		"计划部署的阶段必须覆盖全部设备（batch_size 不填或为 100）")
+)
+
+// StartTime 返回计划开始时间；没有设置时返回 nil（立即开始）。
+func (c DeploymentConstructor) StartTime() *time.Time {
+	if len(c.Phases) == 0 {
+		return nil
+	}
+	return c.Phases[0].StartTs
+}
+
+// ValidateSchedule 校验计划部署参数：只允许一个覆盖全部设备的阶段，
+// 开始时间不能晚于 now+maxAhead（maxAhead<=0 表示不限制）。
+// 开始时间早于当前时间等同于立即开始，允许提交。
+func (c DeploymentConstructor) ValidateSchedule(now time.Time, maxAhead time.Duration) error {
+	if len(c.Phases) == 0 {
+		return nil
+	}
+	if len(c.Phases) > 1 {
+		return ErrScheduleMultiplePhases
+	}
+	if size := c.Phases[0].BatchSize; size != nil && *size != ScheduleBatchSizeAll {
+		return ErrScheduleBatchSize
+	}
+	start := c.StartTime()
+	if start != nil && maxAhead > 0 && start.After(now.Add(maxAhead)) {
+		return errors.Errorf("计划开始时间最多只能在 %g 小时之后（收到 %s）",
+			maxAhead.Hours(), start.Format(time.RFC3339))
+	}
+	return nil
+}
+
+// NotStartedAt 判断部署在 now 时刻是否仍是未开始的计划部署：
+// 未结束，且设置了晚于 now 的开始时间。
+func (d *Deployment) NotStartedAt(now time.Time) bool {
+	if d == nil || d.DeploymentConstructor == nil || d.Status == DeploymentStatusFinished {
+		return false
+	}
+	start := d.StartTime()
+	return start != nil && start.After(now)
+}
