+// liubiao：status=scheduled 只返回未到开始时间且未结束的部署，status=pending 排除它们。
+func TestFindDeploymentsScheduledStatus(t *testing.T) {
+	if testing.Short() {
+		t.Skip("skipping TestFindDeploymentsScheduledStatus in short mode.")
+	}
+	db.Wipe()
+	ctx := context.Background()
+	ds := NewDataStoreMongoWithClient(db.Client())
+
+	future := time.Now().Add(2 * time.Hour)
+	past := time.Now().Add(-2 * time.Hour)
+	insert := func(name string, start *time.Time, status model.DeploymentStatus) {
+		var phases []model.DeploymentPhase
+		if start != nil {
+			phases = []model.DeploymentPhase{{StartTs: start}}
+		}
+		d, err := model.NewDeploymentFromConstructor(&model.DeploymentConstructor{
+			Name:         name,
+			ArtifactName: "app-1.0",
+			Devices:      []string{uuid.NewString()},
+			Phases:       phases,
+		})
+		assert.NoError(t, err)
+		d.Id = uuid.NewString()
+		d.Status = status
+		assert.NoError(t, ds.InsertDeployment(ctx, d))
+	}
+	insert("scheduled", &future, model.DeploymentStatusPending)
+	insert("started", &past, model.DeploymentStatusPending)
+	insert("immediate", nil, model.DeploymentStatusPending)
+	insert("aborted-scheduled", &future, model.DeploymentStatusFinished)
+
+	names := func(status model.StatusQuery) []string {
+		deployments, count, err := ds.FindDeployments(ctx, model.Query{Status: status})
+		assert.NoError(t, err)
+		out := make([]string, 0, len(deployments))
+		for _, d := range deployments {
+			out = append(out, d.Name)
+		}
+		sort.Strings(out)
+		assert.Equal(t, int64(len(out)), count)
+		return out
+	}
+	assert.Equal(t, []string{"scheduled"}, names(model.StatusQueryScheduled))
+	assert.Equal(t, []string{"immediate", "started"}, names(model.StatusQueryPending))
+	assert.Equal(t, []string{"aborted-scheduled"}, names(model.StatusQueryFinished))
+	assert.Len(t, names(model.StatusQueryAny), 4)
+
+	// 读回的计划部署保留开始时间，对外显示 scheduled
+	deployments, _, err := ds.FindDeployments(ctx, model.Query{Status: model.StatusQueryScheduled})
+	assert.NoError(t, err)
+	if assert.Len(t, deployments, 1) && assert.NotNil(t, deployments[0].StartTime()) {
+		assert.WithinDuration(t, future, *deployments[0].StartTime(), time.Second)
+		assert.True(t, deployments[0].NotStartedAt(time.Now()))
+	}
+}
