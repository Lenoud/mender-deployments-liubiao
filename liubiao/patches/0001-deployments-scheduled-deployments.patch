+
+func TestValidateSchedule(t *testing.T) {
+	t.Parallel()
+	now := time.Date(2026, 11, 19, 12, 0, 0, 0, time.UTC)
+	inLimit := now.Add(71 * time.Hour)
+	tooFar := now.Add(73 * time.Hour)
+	past := now.Add(-time.Hour)
+	full := 100
+	half := 50
+
+	testCases := map[string]struct {
+		phases []DeploymentPhase
+		err    string
+	}{
+		"ok, no phases":           {},
+		"ok, within limit":        {phases: schedulePhase(&inLimit, nil)},
+		"ok, batch size 100":      {phases: schedulePhase(&inLimit, &full)},
+		"ok, past start":          {phases: schedulePhase(&past, nil)},
+		"ok, phase without start": {phases: schedulePhase(nil, &full)},
+		"error, too far": {
+			phases: schedulePhase(&tooFar, nil),
+			err:    "计划开始时间最多只能在 72 小时之后",
+		},
+		"error, partial batch": {
+			phases: schedulePhase(&inLimit, &half),
+			err:    ErrScheduleBatchSize.Error(),
+		},
+		"error, two phases": {
+			phases: append(schedulePhase(&inLimit, &half), schedulePhase(&tooFar, nil)...),
+			err:    ErrScheduleMultiplePhases.Error(),
+		},
+	}
+	for name, tc := range testCases {
+		tc := tc
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			c := DeploymentConstructor{Name: "foo", ArtifactName: "bar", Phases: tc.phases}
+			err := c.ValidateSchedule(now, 72*time.Hour)
+			if tc.err == "" {
+				assert.NoError(t, err)
+			} else if assert.Error(t, err) {
+				assert.Contains(t, err.Error(), tc.err)
+			}
+		})
+	}
+
+	t.Run("no limit when maxAhead is zero", func(t *testing.T) {
+		farAway := now.Add(365 * 24 * time.Hour)
+		c := DeploymentConstructor{Phases: schedulePhase(&farAway, nil)}
+		assert.NoError(t, c.ValidateSchedule(now, 0))
+	})
+}
