+package app
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/mock"
+
+	"github.com/mendersoftware/mender-server/services/deployments/model"
+	"github.com/mendersoftware/mender-server/services/deployments/store/mocks"
+	"github.com/mendersoftware/mender-server/services/deployments/store/mongo"
+)
+
+// liubiao：设备取更新时，未到开始时间的计划部署不下发、不建设备部署记录，
+// 也不跳过它去取更新的部署。
+func TestGetNewDeploymentForDeviceSchedule(t *testing.T) {
+	t.Parallel()
+	future := time.Now().Add(time.Hour)
+	past := time.Now().Add(-time.Hour)
+	created := time.Now().Add(-2 * time.Hour)
+
+	newDeployment := func(start *time.Time) *model.Deployment {
+		var phases []model.DeploymentPhase
+		if start != nil {
+			phases = []model.DeploymentPhase{{StartTs: start}}
+		}
+		return &model.Deployment{
+			DeploymentConstructor: &model.DeploymentConstructor{
+				Name: "foo", ArtifactName: "bar", Phases: phases,
+			},
+			Id:          "dep",
+			Created:     &created,
+			DeviceCount: intPtr(0),
+			MaxDevices:  1,
+			DeviceList:  []string{"dev"},
+			Status:      model.DeploymentStatusPending,
+			Stats:       model.NewDeviceDeploymentStats(),
+		}
+	}
+
+	testCases := map[string]struct {
+		start    *time.Time
+		assigned bool
+	}{
+		"not started yet: hold back": {start: &future},
+		"start passed: assign":       {start: &past, assigned: true},
+		"immediate: assign":          {assigned: true},
+	}
+	for name, tc := range testCases {
+		tc := tc
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			ctx := context.Background()
+			db := &mocks.DataStore{}
+			db.On("FindLatestInactiveDeviceDeployment", ctx, "dev").
+				Return(nil, nil)
+			db.On("FindNewerActiveDeployment", ctx, mock.AnythingOfType("*time.Time"), "dev").
+				Return(newDeployment(tc.start), nil).Once()
+			if tc.assigned {
+				db.On("GetDeviceDeployment", ctx, "dep", "dev", true).
+					Return(nil, mongo.ErrStorageNotFound)
+				db.On("InsertDeviceDeployment", ctx,
+					mock.AnythingOfType("*model.DeviceDeployment"), true).Return(nil)
+			}
+
+			ds := NewDeployments(db, nil, 0, false)
+			deployment, deviceDeployment, err := ds.getNewDeploymentForDevice(ctx, "dev")
+			assert.NoError(t, err)
+			if tc.assigned {
+				if assert.NotNil(t, deployment) {
+					assert.Equal(t, "dep", deployment.Id)
+				}
+				if assert.NotNil(t, deviceDeployment) {
+					assert.Equal(t, model.DeviceDeploymentStatusPending, deviceDeployment.Status)
+				}
+			} else {
+				assert.Nil(t, deployment)
+				assert.Nil(t, deviceDeployment)
+				db.AssertNotCalled(t, "InsertDeviceDeployment",
+					mock.Anything, mock.Anything, mock.Anything)
+			}
+			db.AssertExpectations(t)
+		})
+	}
+}
